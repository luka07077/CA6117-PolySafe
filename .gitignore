# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Secrets: never commit the real key (copy .env.example to .env; on Streamlit Cloud use the app's Secrets)
.env
.streamlit/secrets.toml

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Streamlit Cloud would pick environment.yml (conda) over requirements.txt
environment.yml

# Regenerated by the app (data/polysafe.db and data/chroma_db/ are committed so the cloud app needs no build step)
data/runtime/
outputs/logs/
outputs/llm_cache.sqlite
*.log

# evaluation: LLM cache (regenerable)
evaluation/results/llm_cache.sqlite
