# Copy to .env and fill in:  cp .env.example .env

# DashScope (Alibaba Cloud Model Studio). One key serves all models used here:
# deepseek-v4-pro-0813 (main agent), deepseek-v4.1-flash (fallback + helper),
# qwen3.7-text-embedding-flash (RAG embeddings).
DASHSCOPE_API_KEY=sk-your-dashscope-key
# OpenAI-compatible endpoint (use https://dashscope-intl.aliyuncs.com/compatible-mode/v1 for an international account)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
